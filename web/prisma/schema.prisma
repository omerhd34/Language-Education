generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum ExerciseType {
  MULTIPLE_CHOICE
  FILL_BLANK
  MATCHING
  LISTENING
  SPEAKING
  TRANSLATION
}

enum VocabularyWordStatus {
  KNOWN
  LEARNING
}

model User {
  id                            String                   @id @default(cuid())
  email                         String                   @unique
  passwordHash                  String
  name                          String?
  emailVerifiedAt               DateTime?
  createdAt                     DateTime                 @default(now())
  updatedAt                     DateTime                 @updatedAt
  vocabularyLearnSelectedCount  Int                      @default(0)
  vocabularyLearnLockedUntil    DateTime?
  refreshTokens                 RefreshToken[]
  emailVerificationTokens       EmailVerificationToken[]
  progress                      UserProgress[]
  vocabularyWords               UserVocabularyWord[]
  streak                        Streak?
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Language {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  courses   Course[]
  words     Word[]
}

model Level {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  sortOrder   Int      @unique
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  courses     Course[]
}

model Course {
  id          String   @id @default(cuid())
  languageId  String
  language    Language @relation(fields: [languageId], references: [id], onDelete: Cascade)
  levelId     String
  level       Level    @relation(fields: [levelId], references: [id])
  title       String
  description String?  @db.Text
  isPublished Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  lessons     Lesson[]

  @@index([languageId])
  @@index([levelId])
}

model Lesson {
  id          String         @id @default(cuid())
  courseId    String
  course      Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title       String
  description String?        @db.Text
  sortOrder   Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  exercises   Exercise[]
  progress    UserProgress[]

  @@index([courseId])
}

model Exercise {
  id        String       @id @default(cuid())
  lessonId  String
  lesson    Lesson       @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  type      ExerciseType
  prompt    String       @db.Text
  payload   Json
  sortOrder Int          @default(0)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([lessonId])
}

model Word {
  id              String   @id @default(cuid())
  languageId      String
  language        Language @relation(fields: [languageId], references: [id], onDelete: Cascade)
  term            String
  translation     String
  phonetic        String?
  exampleSentence String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([languageId, term])
  @@index([languageId])
}

model UserProgress {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId    String
  lesson      Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  completed   Boolean   @default(false)
  score       Int?
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt
  createdAt   DateTime  @default(now())

  @@unique([userId, lessonId])
  @@index([userId])
  @@index([lessonId])
}

model Streak {
  id             String    @id @default(cuid())
  userId         String    @unique
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentStreak  Int       @default(0)
  longestStreak  Int       @default(0)
  lastActivityAt DateTime?
  updatedAt      DateTime  @updatedAt
  createdAt      DateTime  @default(now())
}

model UserVocabularyWord {
  id                   String               @id @default(cuid())
  userId               String
  user                 User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  wordId               String
  status               VocabularyWordStatus
  statusSetAt          DateTime             @default(now())
  studyStartedAt       DateTime?
  passedMultipleChoice Boolean              @default(false)
  passedFillBlank      Boolean              @default(false)
  passedListening      Boolean              @default(false)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  @@unique([userId, wordId])
  @@index([userId])
  @@index([userId, status, statusSetAt])
  @@index([userId, status, studyStartedAt])
}
